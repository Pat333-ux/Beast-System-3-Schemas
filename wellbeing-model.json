{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nwo-dao.org/schemas/wellbeing/wellbeing-model.json",
  "title": "WellbeingModel",
  "description": "SAIA-Class S schema defining the full wellbeing model used by Beast System 3.0, including domains, indicators, scoring envelopes, and trauma-preventive constraints.",

  "type": "object",

  "properties": {
